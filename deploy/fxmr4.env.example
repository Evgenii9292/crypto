# Copy to /etc/fxmr4/fxmr4.env, mode 600, owned by root.
# Do NOT commit real credentials to the repository.
FXMR4_HOST=127.0.0.1
FXMR4_PORT=8768
FXMR4_USER=fxmr4
FXMR4_PASSWORD=REPLACE_WITH_RANDOM_LONG_PASSWORD_MIN_16_CHARS
BYBIT_API_HOST=https://api.bybit.com
BYBIT_SUBACCOUNT_LABEL=Subaccount
# Generated ON THE VPS by deploy/upgrade-v2.sh, never commit its value.
# FXMR4_SEAL_KEY=
# Bybit API is entered through the HTTPS form and encrypted in /var/lib/fxmr4.
# Do not put real Bybit keys into this environment template.
